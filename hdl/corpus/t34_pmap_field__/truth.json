{
  "case": "t34_pmap_field__",
  "axis": "child port a : out std_ulogic, port map (a => r.b), a <= '1' inside the child",
  "differs_from": "t34_port_fld_out",
  "end_time_ns": 100,
  "signals": [
    {
      "scope": "tb",
      "name": "s",
      "width": 1,
      "type": "std_ulogic"
    },
    {
      "scope": "tb",
      "name": "r",
      "type": "trio_t",
      "fields": [
        {
          "name": "a",
          "width": 1,
          "type": "std_ulogic"
        },
        {
          "name": "b",
          "width": 1,
          "type": "std_ulogic"
        },
        {
          "name": "c",
          "width": 1,
          "type": "std_ulogic"
        }
      ]
    },
    {
      "scope": "tb.dut",
      "name": "a",
      "width": 1,
      "type": "std_ulogic",
      "port": "out"
    }
  ],
  "transitions": [
    {
      "time_ns": 0,
      "signal": "s",
      "value": "0"
    },
    {
      "time_ns": 50,
      "signal": "s",
      "value": "1"
    },
    {
      "time_ns": 0,
      "signal": "r.a",
      "value": "0"
    },
    {
      "time_ns": 0,
      "signal": "r.b",
      "value": "0"
    },
    {
      "time_ns": 0,
      "signal": "r.c",
      "value": "0"
    },
    {
      "time_ns": 0,
      "signal": "tb.dut.a",
      "value": "0"
    },
    {
      "time_ns": 50,
      "signal": "r.b",
      "value": "1"
    },
    {
      "time_ns": 50,
      "signal": "tb.dut.a",
      "value": "1"
    }
  ]
}
