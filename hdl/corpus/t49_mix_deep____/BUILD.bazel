load("@rules_vivado//build/vivado:rules.bzl", "vivado_library")
load("//build:wdb_case.bzl", "wdb_case")

package(default_visibility = ["//visibility:public"])

# rules_vivado does not compile two languages into one library, so each
# child lives in its own library and the testbench finds it through -L.
vivado_library(
    name = "leaf",
    srcs = ["leaf.ent.vhdl"],
    library_name = "leaf",
)

vivado_library(
    name = "child",
    srcs = ["child.v"],
    library_name = "child",
)

wdb_case(
    name = "t49_mix_deep____",
    srcs = ["tb.ent.vhdl"],
    extra_deps = [
        ":leaf",
        ":child",
    ],
)
