load("@rules_vivado//build/vivado:rules.bzl", "vivado_library")
load("//build:wdb_case.bzl", "wdb_case")

package(default_visibility = ["//visibility:public"])

# rules_vivado does not compile two languages into one library, so the
# child lives in its own library and the testbench finds it through -L.
vivado_library(
    name = "child",
    srcs = ["child.v"],
    library_name = "child",
)

wdb_case(
    name = "t21_mix_v_in_vh_",
    srcs = ["tb.ent.vhdl"],
    extra_deps = [":child"],
)
