load(
    "@rules_vivado//build/vivado:rules.bzl",
    "vivado_library",
    "vivado_simulation",
)
load("//build:convert_test.bzl", "conversion_test")

package(default_visibility = ["//visibility:public"])

# The NEORV32 sources and the project's own testbench come from the
# release archive named in MODULE.bazel; only the wrapper that stops
# the run is written here.
vivado_library(
    name = "lib",
    srcs = [
        # Compilation order matters to xvhdl; do not sort.
        # do not sort
        "@neorv32//:core",
        "@neorv32//:sim",
        "tb.ent.vhdl",
    ],
    library_name = "neorv32",
)

# bazel build //hdl/neorv32:sim
#
# Boots NEORV32 from the instruction memory image of the release under
# xsim and writes the waveform database to
# bazel-bin/hdl/neorv32/sim.wdb, next to sim.vcd.
vivado_simulation(
    name = "sim",
    library = ":lib",
    top = "tb",
)

# The database of this design converts to FST. It holds 18875466 value
# changes over 5696 objects, so the conversion takes about seventy
# seconds and about a gigabyte.
# The design is too large to keep an SQLite copy of in a test: it is
# 18875466 value changes for neorv32. //pkg/sqlout holds the rows to
# the VCD on the small designs instead.
conversion_test(
    name = "convert",
    size = "large",
    timeout = "moderate",
    sim = ":sim",
    sqlite = False,
)
