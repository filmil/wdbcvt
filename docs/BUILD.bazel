load("@rules_go//go:def.bzl", "go_test")

# Every document of the repository, held to the writing rules of
# AGENTS.md. Run it alone with:
#
#     bazel test //docs:docs_test
go_test(
    name = "docs_test",
    srcs = ["prose_test.go"],
    data = [
        "//:markdown",
        "//docs:markdown",
    ],
    deps = ["//tools/prose"],
)

filegroup(
    name = "markdown",
    srcs = glob([
        "*.md",
        "format/*.md",
    ]),
    visibility = ["//visibility:public"],
)

# An archive bundling all the discovered WDB spec documentation.
genrule(
    name = "archive",
    srcs = [":markdown"],
    outs = ["wdbcvt-docs.tar.gz"],
    cmd = """
        tar -h --sort=name --mtime='@0' --owner=0 --group=0 --numeric-owner \
            -czf $@ $(locations :markdown)
    """,
    visibility = ["//visibility:public"],
)
