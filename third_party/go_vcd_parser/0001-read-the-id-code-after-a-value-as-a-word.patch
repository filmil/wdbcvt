Subject: [PATCH] vcd: read the identifier code after a value as a word

Vivado writes VCD identifier codes over the printable ASCII range, so
a design with enough variables gets codes such as `#0` and `R0`. The
lexer's timestamp rule, `#\d+`, claims the first and its real rule,
`[r|R]<float>`, the second, and a value change like `bx #0` or
`b0 R0` fails to parse with `unexpected token "bx"`. After a vector,
real or state value the next word is the identifier code, whatever it
looks like, so the value rules of the value change section push a
state whose only rule is a word.

The groups of the value patterns become non-capturing at the same
time. participle hands a rule's groups to its action, and a group that
did not take part is -1, which panics the lexer in `slice bounds out
of range [:-1]`; the optional exponent of the real pattern is one.

--- a/vcd/lexer.go	2026-09-04 04:15:32.122102597 +0200
+++ b/vcd/lexer.go	2026-09-04 04:17:29.581107797 +0200
@@ -10,8 +10,10 @@
 
 // See: https://github.com/google/re2/wiki/Syntax
 const (
-	BinstringPattern  = `[bB]([10xXzZuU])+`
-	FloatPattern      = `[+-]?([0-9]*\.?[0-9]+|[0-9]+\.?[0-9]*)([eE][+-]?[0-9]+)?` // Generated by Gemini.
+	// The groups are non-capturing: participle hands a rule's groups to
+	// its action, and a group that did not take part is -1.
+	BinstringPattern  = `[bB](?:[10xXzZuU])+`
+	FloatPattern      = `[+-]?(?:[0-9]*\.?[0-9]+|[0-9]+\.?[0-9]*)(?:[eE][+-]?[0-9]+)?` // Generated by Gemini.
 	RealStringPattern = `[r|R]` + FloatPattern
 	IntPattern        = `[+-]?[0-9]+`
 	StringPattern     = `\w+`
@@ -162,6 +164,24 @@
 
 // anyWordsEndingWithKwEnd is a set of lexical rules that accept a sequence of
 // any words, separated by whitespace, until `$end` is encountered.
+// valueIdCodeRules read the identifier code that follows a vector
+// value. Vivado writes identifier codes over the printable ASCII
+// range, so a code can look like any other token: `#0` matches the
+// timestamp rule and `R0` the real rule. After a value the next word
+// is the code, whatever it looks like.
+var valueIdCodeRules = []lexer.Rule{
+	{Name: "ws", Pattern: WhitespacePattern, Action: nil},
+	{Name: "IdCode", Pattern: AnyWordPattern, Action: lexer.Pop()},
+}
+
+// valueRules are the value tokens of the value change section, which
+// hand the word after them to ValueIdCode.
+var valueRules = []lexer.Rule{
+	{Name: "Binstring", Pattern: BinstringPattern, Action: lexer.Push("ValueIdCode")},
+	{Name: "RealString", Pattern: RealStringPattern, Action: lexer.Push("ValueIdCode")},
+	{Name: "StateString", Pattern: StatePattern, Action: lexer.Push("ValueIdCode")},
+}
+
 var anyWordsEndingWithKwEnd = []lexer.Rule{
 	// Allows matching $end in $end, but not in $enddefinition.
 	{Name: "KwEndSpecial", Pattern: `\$end(\s+|$)`, Action: lexer.Pop()},
@@ -200,10 +220,11 @@
 		"AttrEndTokens":   {lexer.Include("DateTokens")},
 		"VarTokens":       anyWordsEndingWithKwEndWithWs,
 
-		"AfterEnddefinitions": SimpleStringlessRules([]lexer.Rule{
+		"AfterEnddefinitions": SimpleStringlessRules(append([]lexer.Rule{
 			{Name: "KwEnd", Pattern: `\$end`, Action: nil},
 			{Name: "KwComment", Pattern: `\$comment`, Action: lexer.Push("CommentTokens")},
-		}),
+		}, valueRules...)),
+		"ValueIdCode": valueIdCodeRules,
 	}
 	//fmt.Printf("Rules: %+v", rules["AfterEnddefinitions"])
 	return lexer.MustStateful(rules)
@@ -211,9 +232,10 @@
 
 func NewIdLexer() *lexer.StatefulDefinition {
 	return lexer.MustStateful(lexer.Rules{
-		"Root": SimpleStringlessRules([]lexer.Rule{
+		"Root": SimpleStringlessRules(append([]lexer.Rule{
 			{Name: "KwComment", Pattern: `\$comment`, Action: lexer.Push("CommentTokens")},
-		}),
+		}, valueRules...)),
 		"CommentTokens": anyWordsEndingWithKwEnd,
+		"ValueIdCode":   valueIdCodeRules,
 	})
 }
