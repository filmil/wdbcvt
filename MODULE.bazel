module(
    name = "wdbcvt",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "bazel_lib", version = "3.3.1")
bazel_dep(name = "rules_vivado", version = "3.10.1")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)

# Go is the hermetic toolchain for everything that is not HDL. The SDK
# version comes from go.mod, so there is one place to bump it.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_filmil_go_vcd_parser")

# Hermetic, Bazel-managed Vivado. Selected by
# `build --@rules_vivado//:vivado_mode=hermetic` in //.bazelrc; no Docker
# image and no host Vivado are involved.
vivado = use_extension("@rules_vivado//:extensions.bzl", "vivado")
vivado.install(
    # The shared install cache. Every workspace and every user on the
    # machine reuses this one installation, and `bazel clean --expunge`
    # leaves it alone, so the multi-hour install happens once per host.
    install_cache = "/data/cache/vivado-install",
    # No `sha256`, but not for the reason rules_vivado's README gives.
    # That README says omitting it avoids a second ~100 GB copy in the
    # repository cache. Measured on Bazel 9.2.0, that is not so: with no
    # `sha256` set, Bazel hashed the archive itself and stored it at
    # /data/cache/bazel/repo/content_addressable/sha256/cd1021b0.../file
    # at exactly 102739568640 bytes, the archive's own size. The copy
    # happens either way, so setting `sha256` would cost nothing and buy
    # integrity checking. Set it when someone confirms the same on the
    # Bazel version in .bazelversion:
    # cd1021b04166e43c0d59cbbded7b1687dda5e9dad890b82492f872b2fe32a725
    #
    # Only Artix-7 is installed. Simulation needs no device family at all,
    # but xsim ships with the device libraries and one small family keeps
    # the installation from ballooning.
    modules = ["Artix-7"],
    # The AMD unified installer archive, downloaded once by hand because
    # the AMD site requires a login. Keep the mirror path in sync with
    # //.forgejo/workflows and with README.md.
    urls = ["file:///data/tools/archives/FPGAs_AdaptiveSoCs_Unified_SDI_2025.2_1114_2157_1.tar"],
)
use_repo(vivado, "vivado_hermetic")

# SERV, the bit serial RISC-V core, as the design nobody wrote for this
# repository. The reader is confirmed on it, not tuned against it; see
# docs/corpus.md. Pinned to a release so that the database it produces
# stays comparable between runs.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "serv",
    build_file = "//third_party/serv:serv.BUILD",
    # xvlog without --relax rejects a net used before its declaration,
    # which serv_state.v does once. The patch moves the declaration up
    # and changes nothing else.
    patch_args = ["-p1"],
    patches = ["//third_party/serv:0001-declare-trap_pending-before-use.patch"],
    sha256 = "f81c37b9f9d548c658e23bb7eb90fbed8b54e2e9e51fa42b8cd2f34cecc472ab",
    strip_prefix = "serv-1.4.0",
    urls = ["https://github.com/olofk/serv/archive/refs/tags/1.4.0.tar.gz"],
)
