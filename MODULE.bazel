module(
    name = "wdbcvt",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "bazel_lib", version = "3.3.1")
bazel_dep(name = "rules_vivado", version = "3.10.1")
bazel_dep(name = "zlib", version = "1.3.1.bcr.8")
bazel_dep(name = "rules_cc", version = "0.2.14")

# The report under //docs/latex is built by pdflatex from the host, which
# the `vivado` runner has along with the IEEEtran class. rules_latex_host
# lives in the registry named first in .bazelrc.
bazel_dep(name = "rules_latex_host", version = "0.2.0")

# A hermetic C toolchain for the one cgo target, libfst. The host has a
# compiler but no libstdc++ development files, which the cgo link step
# asks for, and the release must not inherit the build machine's glibc.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains("@zig_sdk//toolchain:linux_amd64_gnu.2.31")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)

# Go is the hermetic toolchain for everything that is not HDL. The SDK
# version comes from go.mod, so there is one place to bump it.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Vivado writes VCD identifier codes over the printable ASCII range, so
# a design with enough variables gets codes such as `#0`, which the
# parser's lexer reads as a timestamp. //hdl/neorv32:sim is the first
# design here large enough to produce one. The patch lets the value
# change rules take a timestamp token as an identifier code.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/go_vcd_parser:0001-read-the-id-code-after-a-value-as-a-word.patch"],
    path = "github.com/filmil/go-vcd-parser",
)
use_repo(go_deps, "com_github_filmil_go_vcd_parser")

# Hermetic, Bazel-managed Vivado. Selected by
# `build --@rules_vivado//:vivado_mode=hermetic` in //.bazelrc; no Docker
# image and no host Vivado are involved.
vivado = use_extension("@rules_vivado//:extensions.bzl", "vivado")
vivado.install(
    # The shared install cache. Every workspace and every user on the
    # machine reuses this one installation, and `bazel clean --expunge`
    # leaves it alone, so the multi-hour install happens once per host.
    install_cache = "/data/cache/vivado-install",
    # No `sha256`, but not for the reason rules_vivado's README gives.
    # That README says omitting it avoids a second ~100 GB copy in the
    # repository cache. Measured on Bazel 9.2.0, that is not so: with no
    # `sha256` set, Bazel hashed the archive itself and stored it at
    # /data/cache/bazel/repo/content_addressable/sha256/cd1021b0.../file
    # at exactly 102739568640 bytes, the archive's own size. The copy
    # happens either way, so setting `sha256` would cost nothing and buy
    # integrity checking. Set it when someone confirms the same on the
    # Bazel version in .bazelversion:
    # cd1021b04166e43c0d59cbbded7b1687dda5e9dad890b82492f872b2fe32a725
    #
    # Only Artix-7 is installed. Simulation needs no device family at all,
    # but xsim ships with the device libraries and one small family keeps
    # the installation from ballooning.
    modules = ["Artix-7"],
    # The AMD unified installer archive, downloaded once by hand because
    # the AMD site requires a login. Keep the mirror path in sync with
    # //.forgejo/workflows and with README.md.
    urls = ["file:///data/tools/archives/FPGAs_AdaptiveSoCs_Unified_SDI_2025.2_1114_2157_1.tar"],
)
use_repo(vivado, "vivado_hermetic")

# SERV, the bit serial RISC-V core, as the design nobody wrote for this
# repository. The reader is confirmed on it, not tuned against it; see
# docs/corpus.md. Pinned to a release so that the database it produces
# stays comparable between runs.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "serv",
    build_file = "//third_party/serv:serv.BUILD",
    # xvlog without --relax rejects a net used before its declaration,
    # which serv_state.v does once. The patch moves the declaration up
    # and changes nothing else.
    patch_args = ["-p1"],
    patches = ["//third_party/serv:0001-declare-trap_pending-before-use.patch"],
    sha256 = "f81c37b9f9d548c658e23bb7eb90fbed8b54e2e9e51fa42b8cd2f34cecc472ab",
    strip_prefix = "serv-1.4.0",
    urls = ["https://github.com/olofk/serv/archive/refs/tags/1.4.0.tar.gz"],
)

# NEORV32, a RISC-V processor written in VHDL, as the large VHDL design
# nobody wrote for this repository. Its testbench boots from the
# instruction memory image the release ships, so the run needs no
# toolchain.
http_archive(
    name = "neorv32",
    build_file = "//third_party/neorv32:neorv32.BUILD",
    sha256 = "1a620cc1ab2380934ed6cf3ce3f26a0bb703a07b6851959c47fc7a0815540f72",
    strip_prefix = "neorv32-1.11.7",
    urls = ["https://github.com/stnolting/neorv32/archive/refs/tags/v1.11.7.tar.gz"],
)

# libfst, the FST reader and writer of GTKWave, MIT. The writer is the
# reference implementation of the output format, so the converter calls
# it through cgo rather than keeping a second one.
http_archive(
    name = "libfst",
    build_file = "//third_party/libfst:libfst.BUILD",
    sha256 = "be5faa372dcaa4141445d0a4f8dd672114679da08fd6a8b32a7e69b262e188b5",
    strip_prefix = "libfst-c716c1f67e21a06aaf8722830b371516e70dc657",
    urls = ["https://github.com/gtkwave/libfst/archive/c716c1f67e21a06aaf8722830b371516e70dc657.tar.gz"],
)

# PicoRV32, a size optimised RISC-V core in Verilog, as a second design
# nobody wrote for this repository. Its `testbench_ez.v` carries a six
# instruction program in an `initial` block, so the run needs no
# firmware image and no toolchain. Pinned to a commit, because the
# project publishes no releases.
http_archive(
    name = "picorv32",
    build_file = "//third_party/picorv32:picorv32.BUILD",
    sha256 = "050ba03d03eaacadb5953f3ba2218b49866c71d505c2476e49a0c0f5fe14e36c",
    strip_prefix = "picorv32-a473fc8fca393771d83b0ffcf0b14db3393339d8",
    urls = ["https://github.com/YosysHQ/picorv32/archive/a473fc8fca393771d83b0ffcf0b14db3393339d8.tar.gz"],
)

http_archive(
    name = "potato",
    build_file = "//third_party/potato:potato.BUILD",
    # Under VHDL-2008, std_logic_vector is a subtype of std_ulogic_vector,
    # so the to_std_logic_vector of pp_csr becomes a homograph of the one
    # in std_logic_1164 and xvhdl rejects the call. The patch renames the
    # function and its two calls, and changes nothing else.
    patch_args = ["-p1"],
    patches = ["//third_party/potato:0001-rename-cause-conversion.patch"],
    sha256 = "91169a01e267cff211f88705e1677613c74036d9a30638f0eab8a387f5b01466",
    strip_prefix = "potato-0.3",
    urls = ["https://github.com/skordal/potato/archive/refs/tags/v0.3.tar.gz"],
)
