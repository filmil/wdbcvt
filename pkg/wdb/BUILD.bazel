load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "wdb",
    srcs = [
        "container.go",
        "debug.go",
        "diff.go",
        "dump.go",
        "file.go",
        "pages.go",
        "probe.go",
        "stream.go",
        "types.go",
        "value.go",
        "verilog.go",
    ],
    importpath = "git.hdlfactory.com/HDL/wdbcvt/pkg/wdb",
    visibility = ["//visibility:public"],
