    size = "medium",
    srcs = [
        "corpus_test.go",
        "debug_test.go",
        "diff_test.go",
        "probe_test.go",
        "stream_test.go",
        "vcd_test.go",
    ],
    data = [
        "//hdl/corpus:all_truth",
        "//hdl/corpus:all_wdb",
        "//hdl/counter:sim",
        "//hdl/ibex:sim",
        "//hdl/neorv32:sim",
        "//hdl/picorv32:sim",
        "//hdl/potato:sim",
        "//hdl/serv:sim",
        "//hdl/uart:sim",
    ],
    embed = [":wdb"],
    deps = ["@com_github_filmil_go_vcd_parser//vcd"],
